{
    "name": "stylelint-stylus",
    "version": "1.0.0",
    "description": "Stylelint plugin for Stylus",
    "main": "lib/index.js",
    "files": [
        "lib",
        "custom-syntax",
        "standard",
        "recommended",
        "base-config",
        "no-stylus"
    ],
    "scripts": {
        "lint": "biome check .",
        "lint:fix": "biome check --fix .",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "update-fixtures": "cross-env UPDATE_FIXTURES=true bun test",
        "preversion": "bun run update && bun test",
        "version": "bun run lint:fix && git add .",
        "update": "node ./scripts/update.js",
        "docs:watch": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:build-and-preview": "bun run docs:build && npx http-server docs/.vitepress/dist",
        "stylelint": "stylelint \"docs/.vitepress/**/*.css\" \"docs/.vitepress/**/*.vue\" \"docs/.vitepress/**/*.styl\"",
        "make-alias-package": "node ./scripts/make-alias-package.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylus/stylelint-stylus.git"
    },
    "keywords": [
        "stylelint-plugin",
        "stylelint",
        "stylus",
        "lint",
        "linter",
        "pretty",
        "beautify"
    ],
    "author": "Yosuke Ota",
    "funding": "https://opencollective.com/stylus",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/stylus/stylelint-stylus/issues"
    },
    "homepage": "https://stylus.github.io/stylelint-stylus/",
    "peerDependencies": {
        "postcss-syntax": "^0.36.2",
        "stylelint": "^14 || ^15 || ^16"
    },
    "peerDependenciesMeta": {
        "postcss-syntax": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.13",
        "@shikijs/vitepress-twoslash": "^1.2.2",
        "@types/lodash": "^4.17.0",
        "cross-env": "^7.0.3",
        "pako": "^2.1.0",
        "postcss": "^8.5.0",
        "postcss-scss": "^4.0.9",
        "postcss-syntax": "^0.36.2",
        "stylelint": "^16.0.0",
        "stylelint-config-recommended": "^14.0.0",
        "stylelint-stylus": "file:.",
        "vitepress": "^1.0.1"
    },
    "dependencies": {
        "html-tags": "^3.3.1",
        "lodash": "^4.17.21",
        "mathml-tag-names": "^2.1.3",
        "postcss-html": "^1.8.0",
        "postcss-media-query-parser": "^0.2.3",
        "postcss-selector-parser": "^6.1.2",
        "postcss-styl": "^0.12.3",
        "postcss-value-parser": "^4.2.0",
        "semver": "^7.7.0",
        "style-search": "^0.1.0",
        "stylelint-config-html": "^1.1.0",
        "svg-tags": "^1.0.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
