{
    "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
    "files": {
        "includes": [
            "**",
            "!.nyc_output",
            "!.opencode",
            "!.devcontainer",
            "!coverage",
            "!test-file",
            "!tests/fixtures",
            "!docs/.vitepress/dist",
            "!docs/.vitepress/cache",
            "!issues",
            "!alias-package"
        ],
        "ignoreUnknown": true
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "double",
            "trailingCommas": "all"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "linter": {
        "rules": {
            "recommended": true,
            "complexity": {
                "noForEach": "off"
            },
            "style": {
                "noUnusedTemplateLiteral": "off",
                "useNodejsImportProtocol": "off",
                "noParameterAssign": "off",
                "useDefaultParameterLast": "off"
            },
            "suspicious": {
                "noDoubleEquals": "off",
                "noRedundantUseStrict": "off",
                "noAssignInExpressions": "off"
            },
            "correctness": {
                "noUnusedVariables": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["custom-syntax/**/*.js"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUndeclaredDependencies": "off"
                    }
                }
            }
        }
    ]
}
